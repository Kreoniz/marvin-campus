{
  "name": "marvin-campus",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none src/lib/*.test.ts src/features/schedule/model/*.test.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint --deny-warnings src public/theme.js vite.config.ts pwa-build.ts",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tanstack/react-hotkeys": "0.17.0",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unlikely-ui": "0.1.0-alpha.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
